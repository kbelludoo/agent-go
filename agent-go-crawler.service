[Unit]
Description=Agent-Go Autonomous Web Crawler and Distinct Sites Telemetry Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agent-go-crawler
ExecStart=/home/ubuntu/agent-go-crawler/live-agent-crawler -addr :8082 -output /home/ubuntu/agent-go-crawler/docs/live_crawler_data.json -distinct-output /home/ubuntu/agent-go-crawler/docs/distinct_sites.json -seed /home/ubuntu/agent-go-crawler/data/distinct_seed_sites.txt -interval 12
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
